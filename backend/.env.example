# Start from the repository root. Copy to backend/.env; never commit backend/.env.
# Default SQLite is an independent local test DB; the teammate's MySQL dump is untouched.
PETLO_DATABASE_URL=sqlite:///backend/data/petlo.sqlite3
# To use an existing MySQL database, use mysql+pymysql://USER:PASSWORD@127.0.0.1/petlo
# Set PETLO_SEED_DEMO=false and PETLO_LOCAL_USER_ID to an existing user_login.user_id.
PETLO_LOCAL_USER_ID=1
PETLO_SEED_DEMO=true
PETLO_STORAGE_DIR=outputs/backend-storage
PETLO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PETLO_MAX_UPLOAD_MB=1024
PETLO_STAGE_TIMEOUT_SEC=7200
PETLO_MODEL_PATH=yolo11n.pt
# Auto uses CUDA when the installed PyTorch build supports it; otherwise CPU.
PETLO_DEVICE=auto
PETLO_CPU_THREADS=8
PETLO_TILE_BATCH_SIZE=4
# Leave blank to use the existing portable FFmpeg discovery.
PETLO_FFMPEG_DIR=
